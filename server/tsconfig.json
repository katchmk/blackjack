{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "noEmit": true,
    "paths": {
      "@shared/*": ["../src/game/*"]
    }
  },
  "include": ["src/**/*", "../src/game/**/*"],
  "exclude": ["node_modules", "dist"]
}
